# Copy to .env and fill in. NEVER commit .env.
APP_NAME=StreamPulse
APP_ENV=development            # development | testing | production
LOG_LEVEL=INFO
LOG_JSON=true                  # false = human-readable logs while developing
CORS_ORIGINS=http://localhost:3000,http://localhost:5173   # comma-separated frontend origins

# PostgreSQL, synchronous driver. Special characters in the password must be URL-encoded (@ -> %40).
DATABASE_URL=postgresql+psycopg2://streampulse_app:admin@localhost:5432/StreamPulse_FastAPI_Next_JS
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15

# Generate with:  python -m scripts.generate_secrets      (each >= 32 chars)
SECRET_KEY=GENERATE_ME            # signs JWT access/refresh tokens
API_KEY_PEPPER=GENERATE_ME        # HMAC key for hashing producer API keys

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# Ingestion limits
MAX_BATCH_SIZE=100
MAX_PAYLOAD_BYTES=16384
MAX_REQUEST_BODY_BYTES=2097152
DEFAULT_RATE_LIMIT_PER_MINUTE=600
SUPPORTED_SCHEMA_VERSIONS=1.0

# Queue / workers (keep small on a laptop)
EVENT_QUEUE_MAXSIZE=1000
EVENT_WORKER_CONCURRENCY=2
EVENT_MAX_RETRIES=3
EVENT_RETRY_BASE_DELAY_SECONDS=2
EVENT_RETRY_MAX_DELAY_SECONDS=60
EVENT_PROCESSING_TIMEOUT_SECONDS=30
EVENT_SWEEP_INTERVAL_SECONDS=5

# Optional, used only by `python populate.py` (otherwise you are prompted; there are NO default credentials)
# SUPERUSER_EMAIL=you@example.com
# SUPERUSER_PASSWORD=
